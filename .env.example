# Copy to .env. Never commit real secrets.
PORT=3100

# Online database (database MediQ_Online, created by ../server/sql/002_create_online_database_MediQ_Online.sql)
ONLINE_SQL_SERVER=
ONLINE_SQL_DATABASE=MediQ_Online
# Where the tables are: dbo in MediQ_Online (the HTTPS way); for the PULL way point the lines above at the AIA-GO server/database (AIAGO), use the read-only
# login mediq_online_reader (server/sql/009) and set  ONLINE_SQL_SCHEMA=MediQ  (the hospitals then write into AIA-GO and this site pulls from it).
ONLINE_SQL_SCHEMA=dbo
ONLINE_SQL_USER=mediq_online_app
ONLINE_SQL_PASSWORD=

# The hospitals / branches that may send data here: HOSPITAL CODE : SECRET, comma separated. Each secret long and random (16+ characters), the same value as
# ONLINE_SYNC_SECRET in that hospital's server/.env, whose ONLINE_SYNC_SITE is the hospital code (e.g. 24191). Patients get links like /track/24191/AB12CD.
# (HTTPS way only. In the PULL way leave this empty: nothing can send here, every hospital code with rows in AIA-GO is served.)
ONLINE_HOSPITALS=24191:,40750:
# A link without a hospital code (/track/AB12CD) belongs to this hospital (only needed when several hospitals send)
ONLINE_DEFAULT_HOSPITAL=

# The patient tracking app, built with: cd ../frontend && npm run build:standalone -- track   (then point this at dist-standalone/track)
ONLINE_PUBLIC_DIST=../frontend/dist-standalone/track

# Behind Nginx/Cloudflare? set to 1 so rate limiting sees the real visitor address
TRUST_PROXY=
# Patients may type the queue number instead of the tracking code (off by default: the code is private, numbers are guessable)
ALLOW_NUMBER_LOOKUP=false
